# ────────────────────────────────────────────────
# RAG Studio – Environment Configuration
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ── PostgreSQL ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# Full async SQLAlchemy URL (auto-built in docker-compose from above)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# ── RAG Tuning ──────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ── Hybrid Search Weights ───────────────────────
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# ── Reranking (Optional) ────────────────────────
RERANK_ENABLED=false
# Options: score | cohere | bge | jina
RERANK_PROVIDER=score
COHERE_API_KEY=
RERANK_API_URL=

# ── Security ────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
